# Serves the static build only; the cluster Ingress routes /api to kiwi.
{
	admin off
	auto_https off
}

:8080 {
	root * /usr/share/caddy
	encode zstd gzip

	# The safe browser headers on every response of the app. A Content-Security-Policy is not
	# among them: it needs a pass in a real browser (PWA, service worker, self-hosted fonts).
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
	}

	# Kubernetes probes: this process is up, and it has no dependencies to wait for.
	handle /healthz {
		respond "ok" 200
	}
	handle /readyz {
		respond "ok" 200
	}

	# Hashed build output never changes under its name. A missing hash is a 404 that must not be cached for
	# a year, and never the app shell.
	handle /assets/* {
		@present file {path}
		header @present Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else revalidates: index.html, sw.js, manifest.webmanifest, the icons and the
	# single-page-app fallback to index.html (so any file the build adds, such as registerSW.js, revalidates too).
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
