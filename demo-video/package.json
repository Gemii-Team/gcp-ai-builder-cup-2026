{
  "name": "kiwi-demo-video",
  "version": "0.1.0",
  "private": true,
  "description": "The K.I.W.I. demo video: a Playwright recorder that drives the running app, and a Remotion composition that turns the captured frames into the 3.5-minute screen demo.",
  "scripts": {
    "login": "tsx scripts/login.ts",
    "consent": "tsx scripts/consent.ts",
    "record": "tsx scripts/record.ts",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts KiwiDemo out/kiwi-demo.mp4 --codec h264 --crf 16",
    "still": "remotion still src/index.ts KiwiDemo out/poster.png --frame 60",
    "typecheck": "tsc --noEmit",
    "take": "bash scripts/take.sh"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/media-utils": "^4.0.536",
    "@remotion/transitions": "4.0.536",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
