# Local-only documentation: specs, plans, ADRs, notes. Never pushed.
/docs/
# Design records (impeccable): product/design docs, briefs, mocks, galleries
/PRODUCT.md
/DESIGN.md
/.impeccable/
# Agent working files (briefs, ledgers, reports): never pushed
/.superpowers/

# Secrets and credentials
.env
.env.*
!.env.example
kubeconfig
kubeconfig*
*.kubeconfig
*.pem
*.key
*.p12
*-credentials.json
*-sa-key.json
service-account*.json
application_default_credentials.json
# The OAuth client file the Google console offers for download (client_secret_<id>.apps.googleusercontent.com.json)
client_secret*.json

# Terraform state, plans and variable files (can contain secrets)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
*.tfvars
crash.log
# Terragrunt's working copies of the modules and its per-environment values (project id, bucket
# name, repository, domain, billing account: the committed example lists the names).
.terragrunt-cache/
/deploy/terraform/live/env.hcl

# Build and tool output
node_modules/
.turbo/
dist/
coverage/
# turbo writes one when run; never commit it
/AGENTS.md

# Playwright output of the smoke suite
/e2e/test-results/
/e2e/playwright-report/
