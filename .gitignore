# Local-only documentation: specs, plans, ADRs, notes. Never pushed.
/docs/
# Design records (impeccable): product/design docs, briefs, mocks, galleries
/PRODUCT.md
/DESIGN.md
/.impeccable/

# Secrets and credentials
.env
.env.*
!.env.example
kubeconfig
kubeconfig*
*.kubeconfig
*.pem
*.key
*.p12
*-credentials.json
*-sa-key.json
service-account*.json
application_default_credentials.json

# Terraform state, plans and variable files (can contain secrets)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
*.tfvars
crash.log

# Build and tool output
node_modules/
.turbo/
dist/
coverage/
# turbo writes one when run; never commit it
/AGENTS.md

# Playwright output of the smoke suite
/e2e/test-results/
/e2e/playwright-report/
