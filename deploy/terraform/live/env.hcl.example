# Copy to env.hcl (git-ignored) and fill in. This file lists names only: no value belongs here.
# Terragrunt reads env.hcl from every unit through root.hcl.
locals {
  # --- required ---------------------------------------------------------------------------
  # The Google Cloud project that holds everything.
  project_id = ""
  # The Cloud Storage bucket that holds Terraform state. Create it by hand first (README).
  state_bucket = ""
  # The GitHub repository, owner/name, whose main-branch workflows may deploy.
  github_repository = ""

  # --- the profile: the shape of the whole stack ------------------------------------------------
  # "minimal" (what an empty value means): ONE Cloud Run container (kiwi serves the web app itself,
  # with an in-process cache), no Memorystore for Valkey, the smallest workable Cloud SQL tier.
  # For about ten people; exactly one instance.
  # "full": a Caddy ingress container plus the kiwi sidecar, and Memorystore for Valkey. The way
  # to scale up; the stack as it was before the minimal profile existed.
  # Anything else stops every unit with an error.
  profile = ""

  # --- optional: leave empty for the default ------------------------------------------------
  # Default asia-southeast1. Cloud Run, Cloud SQL, Valkey and the bucket all live in it.
  region = ""
  # Default <region>-a. Cloud SQL and Valkey are pinned to it.
  zone = ""
  # A host name that serves the app instead of the default run.app URL (no scheme, no path).
  # Setting it changes the URL, the OAuth redirect URI and the bucket's CORS origin; mapping the
  # name to the service is not part of this stack.
  custom_domain = ""
  # A billing account id: only then is a budget with alerts created. Empty creates none.
  billing_account = ""

  # --- optional: Vertex AI (open decision: the Singapore endpoint or the global one) ----------
  vertex_location           = ""
  vertex_embedding_location = ""
  vertex_model_flash        = ""
  vertex_model_pro          = ""
  vertex_embedding_model    = ""

  # --- optional: set after CI has pushed images ------------------------------------------------
  # The image of kiwi (minimal: the one image, which also holds the web app; full: the sidecar).
  kiwi_image = ""
  # The Caddy ingress image: the full profile only. Setting it with the minimal profile is an
  # error, not a silent no-op: that profile has no web image.
  web_image = ""
}
