variable "project_id" {
  description = "The project that owns the secrets."
  type        = string

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{4,28}[a-z0-9]$", var.project_id))
    error_message = "project_id must be a Google Cloud project id (6-30 characters: lowercase letters, digits and hyphens)."
  }
}

variable "region" {
  description = "The one region the secrets are replicated to."
  type        = string
  default     = "asia-southeast1"
}

variable "external_secrets" {
  description = <<-EOT
    Environment variables whose value a person adds out of band (gcloud secrets versions add).
    Terraform creates the secret and a placeholder version and never touches the value after.
    The Google OAuth client cannot be created by Terraform, so its id and secret are here.
  EOT
  type        = set(string)
  default     = ["KIWI_OAUTH_CLIENT_ID", "KIWI_OAUTH_CLIENT_SECRET"]
}

variable "generated_keys" {
  description = <<-EOT
    Environment variables that hold base64 of 32 random bytes (what the app expects of its keys),
    generated by Terraform and written without touching the state. KIWI_TOKEN_ENC_KEY encrypts the
    Google refresh tokens at rest and has no key id: replacing it makes every stored token
    unreadable and every user must consent again (architecture review F38).
  EOT
  type        = set(string)
  default     = ["KIWI_TOKEN_ENC_KEY", "KIWI_BLOB_SIGNING_KEY"]

  validation {
    condition     = length(setintersection(var.generated_keys, var.external_secrets)) == 0
    error_message = "A variable cannot be both generated and external: ${join(", ", sort(tolist(setintersection(var.generated_keys, var.external_secrets))))}."
  }
}

variable "keys_version" {
  description = "Raise it to generate and write all generated keys again (a write-only argument is sent only when its version changes). Read the warning on generated_keys first."
  type        = number
  default     = 1
}

variable "accessor_members" {
  description = "IAM members (serviceAccount:...) that read these secrets, each grant on the one secret: the Cloud Run service and the Jobs."
  type        = set(string)
  default     = []
}

variable "labels" {
  description = "Labels of the secrets."
  type        = map(string)
  default     = {}
}
