# K.I.W.I. environment: names only. Copy this file to .env (git-ignored) and fill it in.
# Never put a value in this file. A test keeps it in sync with backend/internal/platform/config.

# --- Private values: LLM endpoint, Google OAuth client, encryption keys ---
# LiteLLM endpoint and virtual key.
KIWI_LLM_BASE_URL=
KIWI_LLM_API_KEY=
# The "kiwi-local" Google OAuth client. Needed only for OVERLAY=local: the default
# mockauth stack signs in through the mock provider and fills in `mock` itself.
KIWI_OAUTH_CLIENT_ID=
KIWI_OAUTH_CLIENT_SECRET=
# Each is base64 of 32 random bytes, for example from `openssl rand -base64 32`.
# KIWI_TOKEN_ENC_KEY encrypts Google refresh tokens at rest; KIWI_BLOB_SIGNING_KEY signs upload and download URLs.
KIWI_TOKEN_ENC_KEY=
KIWI_BLOB_SIGNING_KEY=

# --- Team-specific model ids (whatever your LiteLLM serves) ---
KIWI_LLM_MODEL_FLASH=
KIWI_LLM_MODEL_PRO=
KIWI_ASR_MODEL=

# --- Set by the overlay (deploy/k8s/overlays/{local,mockauth}): leave empty ---
# Unset or empty means the built-in default: KIWI_ENV=local, KIWI_ROLES=api,realtime,worker,agents,
# KIWI_OIDC_ISSUER=Google. The mockauth overlay points KIWI_OIDC_ISSUER and KIWI_OIDC_INTERNAL_URL at the mock sign-in provider (never in prod).
KIWI_ENV=
KIWI_ROLES=
KIWI_PUBLIC_URL=
KIWI_BUS_PROVIDER=
KIWI_BLOB_URL=
KIWI_VALKEY_URL=
KIWI_LLM_PROVIDER=
KIWI_EMBED_BASE_URL=
KIWI_EMBED_MODEL=
KIWI_OIDC_ISSUER=
KIWI_OIDC_INTERNAL_URL=
# Connection strings for the kiwi_app, kiwi_system and kiwi_owner database roles; composed from KIWI_DB_PASSWORD.
KIWI_DATABASE_URL=
KIWI_DATABASE_SYSTEM_URL=
KIWI_MIGRATE_DATABASE_URL=

# --- Optional, presentational only: the sign-in heading and domain hint ---
KIWI_WORKSPACE_NAME=
KIWI_WORKSPACE_DOMAIN=

# --- Script-only: read by scripts/local/*.sh, not by the binary ---
# Password of the local Postgres roles.
KIWI_DB_PASSWORD=
